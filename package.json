{
  "name": "tflive",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "web"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p web/tsconfig.json",
    "build": "npm run build -w web",
    "prestart": "npm run build",
    "predemo": "npm run build",
    "dev:web": "npm run dev -w web",
    "start": "tsx server/src/main.ts",
    "demo": "tsx server/src/main.ts --demo",
    "demo:log": "tsx server/scripts/make-demo-log.ts",
    "mod:check": "bash mod/scripts/tl.sh check",
    "mod:test": "bash mod/scripts/tl.sh gen && luajit mod/test/run.lua",
    "mod:install": "tsx server/scripts/install-mod.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
